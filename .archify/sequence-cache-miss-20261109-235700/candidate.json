  "cards": [
    {
      "dot": "emerald",
      "title": "Request Path",
      "items": [
        "Browser sends an HTTP GET to the API",
        "API first checks Redis before touching Postgres",
        "Cache hit would return directly — no DB round-trip"
      ]
    },
    {
      "dot": "rose",
      "title": "Cache Miss",
      "items": [
        "Redis returns nil — key is absent or expired",
        "API falls back to a Postgres SELECT query",
        "DB rows are returned to the API for processing"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Fill",
      "items": [
        "API writes the result to Redis with a 300 s TTL",
        "Subsequent identical requests will hit the cache",
        "Cache fill is fire-and-forget — does not block the response"
      ]
    }
  ]
