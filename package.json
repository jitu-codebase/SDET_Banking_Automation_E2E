{
  "name": "@sdet-banking-automation/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "clean:api": "rimraf apps/api-tests/test-results apps/api-tests/playwright-report apps/api-tests/reports",
    "clean:ui": "rimraf apps/ui-tests/test-results apps/ui-tests/playwright-report apps/ui-tests/reports",
    "test:api": "pnpm clean:api && nx run api-tests:test",
    "typecheck:api": "nx run api-tests:typecheck",
    "test:ui": "pnpm clean:ui && nx run ui-tests:test",
    "typecheck:ui": "nx run ui-tests:typecheck",
    "report:api": "pnpm exec playwright show-report apps/api-tests/playwright-report",
    "report:ui": "pnpm exec playwright show-report apps/ui-tests/playwright-report",
    "git:push": "node scripts/git-push.mjs"
  },
  "private": true,
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nx/js": "24.0.4",
    "@nx/workspace": "24.0.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.19.43",
    "dotenv": "^18.0.9",
    "nx": "24.0.4",
    "playwright-bdd": "^9.2.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.20.2 <21"
  }
}
